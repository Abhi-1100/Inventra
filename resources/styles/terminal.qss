/* ==========================================================================
   INVENTRA — Pro-Inventory System Design System
   High-Density SaaS, Technical Minimalist aesthetic
   Accent: #afc6ff  |  Base BG: #0b0f14  |  Cards: #161b22 -> #12161c
   ========================================================================== */

/* ── Global base ─────────────────────────────────────────────────────────── */
QWidget {
    background-color: #0b0f14;
    color: #e0e2ea;
    font-family: "Hanken Grotesk", "Segoe UI", "Inter", sans-serif;
    font-size: 13px; /* Corresponds to body-sm / label-sm */
}

QMainWindow, QWidget#CentralWidget {
    background-color: #0b0f14;
}

/* ── Monospace font for data cells ─────────────────────────────────────────  */
QTableView, QHeaderView::section,
QLineEdit[mono="true"], QDoubleSpinBox, QSpinBox, QToolTip {
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 14px; /* data-md */
}

/* ── Sidebar ─────────────────────────────────────────────────────────────── */
QWidget#Sidebar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #161b22, stop:1 #12161c);
    border-right: 1px solid #232a33;
}

/* Active sidebar item simulation using property */
QPushButton#SidebarBtn {
    background: transparent;
    border: none;
    color: #c2c6d6;
    text-align: left;
    padding: 8px 16px;
    font-size: 14px; /* data-md / label-md */
    font-weight: 500;
}
QPushButton#SidebarBtn:hover {
    background-color: rgba(175, 198, 255, 0.05); /* very slight primary tint */
    color: #e0e2ea;
}
QPushButton#SidebarBtn[active="true"] {
    background-color: rgba(175, 198, 255, 0.10); /* 10% opacity blue */
    color: #afc6ff;
    border-left: 4px solid #afc6ff;
}

/* ── QTableView — dense data grid ───────────────────────────────────────── */
QTableView {
    background-color: #0b0f14;
    alternate-background-color: #0b0f14; /* No zebra stripes */
    gridline-color: transparent;
    border: 1px solid #232a33;
    border-radius: 8px;
    selection-background-color: #1c2128;
    selection-color: #e0e2ea;
    outline: none;
}

QTableView::item {
    border-bottom: 1px solid #232a33;
    padding: 12px 16px; /* cell-padding-v and cell-padding-h */
    color: #e0e2ea;
}

QTableView::item:selected {
    background-color: #1c2128;
}

QTableView::item:hover {
    background-color: #1c2128;
}

QHeaderView::section {
    background-color: #0b0f14;
    color: #8c90a0;
    padding: 12px 16px;
    font-weight: 600;
    font-size: 13px; /* label-sm */
    border: none;
    border-bottom: 1px solid #232a33;
    text-transform: uppercase;
}

QHeaderView::section:horizontal:hover {
    background-color: #161b22;
    color: #e0e2ea;
}

/* Sort indicators */
QHeaderView::down-arrow { image: none; }
QHeaderView::up-arrow   { image: none; }

/* ── Scrollbars ─────────────────────────────────────────────────────────── */
QScrollBar:vertical {
    border: none;
    background: #0b0f14;
    width: 6px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #424754;
    min-height: 20px;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover { background: #8c90a0; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none; background: none; height: 0;
}

QScrollBar:horizontal {
    border: none;
    background: #0b0f14;
    height: 6px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #424754;
    min-width: 20px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal:hover { background: #8c90a0; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none; background: none; width: 0;
}

/* ── Form Inputs ─────────────────────────────────────────────────────────── */
QLineEdit, QDoubleSpinBox, QSpinBox, QTextEdit, QPlainTextEdit {
    background-color: #0b0f14;
    border: 1px solid #232a33;
    border-radius: 8px; /* rounded-md */
    padding: 8px 12px;
    color: #e0e2ea;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
}

QLineEdit:focus, QDoubleSpinBox:focus, QSpinBox:focus,
QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #afc6ff;
    /* Simulate 2px outer glow using border, as QSS doesn't support box-shadow */
}

QLineEdit:disabled, QDoubleSpinBox:disabled, QSpinBox:disabled {
    color: #424754;
    background-color: #161b22;
    border-color: #232a33;
}

QDoubleSpinBox::up-button, QSpinBox::up-button,
QDoubleSpinBox::down-button, QSpinBox::down-button {
    background-color: #161b22;
    border: none;
    border-left: 1px solid #232a33;
    width: 16px;
}
QDoubleSpinBox::up-button:hover, QSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover, QSpinBox::down-button:hover {
    background-color: #232a33;
}

/* ── Combo Box ───────────────────────────────────────────────────────────── */
QComboBox {
    background-color: #0b0f14;
    border: 1px solid #232a33;
    border-radius: 8px;
    padding: 8px 12px;
    color: #e0e2ea;
    min-width: 120px;
}
QComboBox:focus  { border: 1px solid #afc6ff; }
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    background-color: #1c2128;
    border: 1px solid #232a33;
    selection-background-color: #1f6feb;
    color: #e0e2ea;
    outline: none;
}

/* ── Push Buttons ────────────────────────────────────────────────────────── */
QPushButton {
    background-color: transparent;
    border: 1px solid #232a33;
    color: #e0e2ea;
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 14px; /* data-md / body-md */
    font-weight: 500;
}
QPushButton:hover {
    background-color: #161b22;
}
QPushButton:pressed {
    background-color: #1c2128;
}
QPushButton:disabled {
    color: #424754;
    background-color: transparent;
    border-color: #232a33;
}

/* Primary action button (blue gradient) */
QPushButton#PrimaryBtn {
    /* Using linear gradient for button as described in design */
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #1f6feb, stop:1 #0059c8);
    border: 1px solid #afc6ff; /* Inner glow effect using border */
    color: #ffffff;
    font-weight: 600;
}
QPushButton#PrimaryBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #388bfd, stop:1 #1f6feb);
}
QPushButton#PrimaryBtn:pressed {
    background: #0050a7;
    border-top: 1px solid transparent;
}

/* Secondary Button (Ghost style) */
QPushButton#SecondaryBtn {
    background-color: transparent;
    border: 1px solid #232a33;
    color: #c2c6d6;
}
QPushButton#SecondaryBtn:hover {
    background-color: rgba(35, 42, 51, 0.5); /* #232a33 with opacity */
}

/* Critical Action button */
QPushButton#DangerBtn {
    background-color: transparent;
    border: 1px solid #ffb4ab;
    color: #ffb4ab;
}
QPushButton#DangerBtn:hover {
    background-color: #ffb4ab;
    color: #690005;
}

/* ── Auth Screen — PIN pad buttons ──────────────────────────────────────── */
QPushButton#PinBtn {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #161b22, stop:1 #12161c);
    border: 1px solid #232a33;
    color: #e0e2ea;
    font-family: "JetBrains Mono", monospace;
    font-size: 24px;
    font-weight: 600;
    border-radius: 8px;
    min-width: 72px;
    min-height: 72px;
}
QPushButton#PinBtn:hover {
    background-color: #1c2128;
    border-color: #afc6ff;
}
QPushButton#PinBtn:pressed {
    background-color: #1f6feb;
    border-color: #afc6ff;
    color: #ffffff;
}

QPushButton#PinBackspaceBtn {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #161b22, stop:1 #12161c);
    border: 1px solid #232a33;
    color: #8c90a0;
    font-size: 24px;
    border-radius: 8px;
    min-width: 72px;
    min-height: 72px;
}
QPushButton#PinBackspaceBtn:hover {
    background-color: #1c2128;
    color: #ffb4ab;
    border-color: #ffb4ab;
}

/* ── Card Elements ───────────────────────────────────────────────────────── */
QFrame#MetricCard, QWidget#AuthCard, QFrame#PanelFrame, QFrame#FormFrame {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #161b22, stop:1 #12161c);
    border: 1px solid #232a33;
    border-radius: 8px;
}

/* ── Dialogs / Popovers ──────────────────────────────────────────────────── */
QDialog, QMenu, QToolTip {
    background-color: #1c2128;
    border: 1px solid #232a33;
    border-radius: 8px;
}
QToolTip {
    color: #c2c6d6;
    padding: 8px 12px;
    font-size: 12px;
}

/* ── Typography Classes (Simulated via Object Names if needed) ───────────── */
QLabel#HeadlineLg {
    font-size: 32px;
    font-weight: 700;
    color: #e0e2ea;
}
QLabel#HeadlineMd {
    font-size: 24px;
    font-weight: 600;
    color: #e0e2ea;
}
QLabel#DataLg {
    font-family: "JetBrains Mono", monospace;
    font-size: 18px;
    font-weight: 500;
}
QLabel#DataMd {
    font-family: "JetBrains Mono", monospace;
    font-size: 14px;
    font-weight: 400;
}
QLabel#DataSm {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    font-weight: 400;
}

/* ── Status Indicators ───────────────────────────────────────────────────── */
QLabel#StatusSafe {
    color: #a8d5ba; /* Green-ish */
}
QLabel#StatusWarning {
    color: #ffdf99; /* Gold-ish */
}
QLabel#StatusCritical {
    color: #ffb4ab; /* Red */
}
