/* ==========================================================================
   INVENTRA — Obsidian Dark Theme (Fincept Terminal Styling)
   Background: #080808  |  Accent: #d97706 (Amber)
   Surface: #0a0a0a     |  Border: #222222  |  Text Primary: #e5e5e5
   Font: 'SF Mono', 'Menlo', 'Cascadia Mono', 'Consolas', monospace
   ========================================================================== */

/* ── Global base ─────────────────────────────────────────────────────────── */
QWidget {
    background-color: #080808;
    color: #e5e5e5;
    font-family: 'SF Mono', 'Menlo', 'Cascadia Mono', 'Consolas', monospace;
    font-size: 13px;
    border: none;
    outline: none;
}

QMainWindow, QWidget#CentralWidget, QWidget#AppShell {
    background-color: #080808;
}

/* ── Monospace data elements ─────────────────────────────────────────────── */
QTableView, QHeaderView::section,
QLineEdit, QDoubleSpinBox, QSpinBox, QComboBox {
    font-family: 'SF Mono', 'Menlo', 'Cascadia Mono', 'Consolas', monospace;
    font-size: 13px;
}

/* ── Sidebar ─────────────────────────────────────────────────────────────── */
QWidget#Sidebar {
    background-color: #0a0a0a;
    border-right: 1px solid #222222;
}

/* ── Body area ───────────────────────────────────────────────────────────── */
QWidget#Body {
    background-color: #080808;
}

/* ── TopAppBar / StatusBar ───────────────────────────────────────────────── */
QWidget#TopAppBar {
    background-color: #080808;
    border-bottom: 1px solid #222222;
}

/* ── Page Stack ──────────────────────────────────────────────────────────── */
QStackedWidget#PageStack {
    background-color: #080808;
}

/* ── QTableView — dense data grid ───────────────────────────────────────── */
QTableView {
    background-color: #080808;
    alternate-background-color: #080808;
    gridline-color: transparent;
    border: 1px solid #222222;
    border-radius: 4px;
    selection-background-color: #0a0a0a;
    selection-color: #e5e5e5;
    outline: none;
}

QTableView::item {
    border-bottom: 1px solid rgba(34, 34, 34, 0.5);
    padding: 10px 16px;
    color: #e5e5e5;
    background-color: transparent;
}

QTableView::item:selected {
    background-color: #111111;
    color: #e5e5e5;
}

QTableView::item:hover {
    background-color: #0a0a0a;
}

QHeaderView {
    background-color: #050505;
    border: none;
}

QHeaderView::section {
    background-color: #050505;
    color: #808080;
    padding: 10px 16px;
    font-family: 'SF Mono', 'Menlo', 'Cascadia Mono', 'Consolas', monospace;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 0.04em;
    border: none;
    border-bottom: 1px solid #222222;
}

QHeaderView::section:horizontal:hover {
    background-color: #0a0a0a;
    color: #e5e5e5;
}

QHeaderView::down-arrow { image: none; width: 0; }
QHeaderView::up-arrow   { image: none; width: 0; }

/* ── Scrollbars ─────────────────────────────────────────────────────────── */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #333333;
    min-height: 20px;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover { background: #808080; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none; background: none; height: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 6px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #333333;
    min-width: 20px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal:hover { background: #808080; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none; background: none; width: 0;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

/* ── Form Inputs ─────────────────────────────────────────────────────────── */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #050505;
    border: 1px solid #222222;
    border-radius: 3px;
    padding: 6px 10px;
    color: #e5e5e5;
    selection-background-color: #d97706;
    selection-color: #ffffff;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #d97706;
    background-color: #050505;
}

QLineEdit:disabled {
    color: #525252;
    background-color: #0a0a0a;
    border-color: #222222;
}

QDoubleSpinBox, QSpinBox {
    background-color: #050505;
    border: 1px solid #222222;
    border-radius: 3px;
    padding: 6px 10px;
    color: #e5e5e5;
    selection-background-color: #d97706;
    selection-color: #ffffff;
}

QDoubleSpinBox:focus, QSpinBox:focus {
    border: 1px solid #d97706;
}

QDoubleSpinBox::up-button, QSpinBox::up-button,
QDoubleSpinBox::down-button, QSpinBox::down-button {
    background-color: #0a0a0a;
    border: none;
    border-left: 1px solid #222222;
    width: 18px;
    border-radius: 0;
}
QDoubleSpinBox::up-button:hover, QSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover, QSpinBox::down-button:hover {
    background-color: #111111;
}

/* ── Combo Box ───────────────────────────────────────────────────────────── */
QComboBox {
    background-color: #0a0a0a;
    border: 1px solid #222222;
    border-radius: 3px;
    padding: 6px 12px;
    color: #e5e5e5;
    min-width: 120px;
}
QComboBox:focus { border: 1px solid #d97706; }
QComboBox::drop-down {
    border: none;
    width: 24px;
    border-radius: 0 3px 3px 0;
}
QComboBox::down-arrow {
    image: none;
    width: 0;
}
QComboBox QAbstractItemView {
    background-color: #0a0a0a;
    border: 1px solid #222222;
    border-radius: 3px;
    selection-background-color: #111111;
    selection-color: #d97706;
    color: #e5e5e5;
    outline: none;
    padding: 4px;
}
QComboBox QAbstractItemView::item {
    padding: 6px 12px;
    border-radius: 2px;
}

/* ── Push Buttons (base) ────────────────────────────────────────────────── */
QPushButton {
    background-color: #111111;
    border: 1px solid #222222;
    color: #e5e5e5;
    padding: 5px 12px;
    border-radius: 3px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #161616;
    border-color: #d97706;
}
QPushButton:pressed {
    background-color: #080808;
}
QPushButton:disabled {
    color: #525252;
    background-color: transparent;
    border-color: #222222;
}

/* ── Primary CTA button ─────────────────────────────────────────────────── */
QPushButton#PrimaryBtn {
    background: #d97706;
    border: 1px solid #d97706;
    color: #080808;
    font-weight: bold;
    border-radius: 3px;
}
QPushButton#PrimaryBtn:hover {
    background: #f59e0b;
    border-color: #f59e0b;
}
QPushButton#PrimaryBtn:pressed {
    background: #b45309;
    border-color: #b45309;
}

/* ── Secondary Ghost button ──────────────────────────────────────────────── */
QPushButton#SecondaryBtn {
    background-color: transparent;
    border: 1px solid #222222;
    color: #808080;
}
QPushButton#SecondaryBtn:hover {
    background-color: #0a0a0a;
    border-color: #d97706;
    color: #e5e5e5;
}

/* ── Danger button ───────────────────────────────────────────────────────── */
QPushButton#DangerBtn {
    background-color: transparent;
    border: 1px solid rgba(220, 38, 38, 0.5);
    color: #dc2626;
    border-radius: 3px;
}
QPushButton#DangerBtn:hover {
    background-color: #dc2626;
    color: #ffffff;
    border-color: #dc2626;
}

/* ── Filter Chip buttons ─────────────────────────────────────────────────── */
QPushButton#FilterChip {
    background-color: #0a0a0a;
    border: 1px solid #222222;
    color: #808080;
    border-radius: 12px;
    padding: 4px 14px;
    font-size: 11px;
    font-weight: bold;
}
QPushButton#FilterChip:hover {
    background-color: #111111;
    border-color: #d97706;
    color: #e5e5e5;
}
QPushButton#FilterChip[active="true"] {
    background-color: rgba(217, 119, 6, 0.15);
    border: 1px solid rgba(217, 119, 6, 0.4);
    color: #d97706;
}

/* ── Auth PIN Keypad buttons ─────────────────────────────────────────────── */
QPushButton#PinBtn {
    background: #111111;
    border: 1px solid #222222;
    color: #e5e5e5;
    font-family: 'SF Mono', 'Menlo', 'Cascadia Mono', 'Consolas', monospace;
    font-size: 20px;
    font-weight: bold;
    border-radius: 38px; /* Full circle for 76x76 */
    min-width: 76px;
    min-height: 76px;
    max-width: 76px;
    max-height: 76px;
}
QPushButton#PinBtn:hover {
    background-color: #161616;
    border-color: #d97706;
}
QPushButton#PinBtn:pressed {
    background-color: rgba(217, 119, 6, 0.3);
    border-color: #d97706;
    color: #ffffff;
}

QPushButton#PinBackspaceBtn {
    background: transparent;
    border: none;
    color: #808080;
    font-size: 20px;
    border-radius: 38px;
    min-width: 76px;
    min-height: 76px;
    max-width: 76px;
    max-height: 76px;
}
QPushButton#PinBackspaceBtn:hover {
    background-color: rgba(220, 38, 38, 0.08);
    color: #dc2626;
}

/* ── Card / Panel Frames ─────────────────────────────────────────────────── */
QFrame#MetricCard, QWidget#AuthCard,
QFrame#PanelFrame, QFrame#FormFrame,
QFrame#GlassCard {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #0a0a0a, stop:1 #080808);
    border: 1px solid #222222;
    border-radius: 4px;
}

/* ── Tab Widget ──────────────────────────────────────────────────────────── */
QTabWidget::pane {
    background: #080808;
    border: 1px solid #222222;
    border-radius: 0 0 4px 4px;
    border-top: none;
}
QTabBar::tab {
    background: transparent;
    color: #808080;
    padding: 8px 20px;
    border: none;
    border-bottom: 2px solid transparent;
    font-family: 'SF Mono', 'Menlo', 'Cascadia Mono', 'Consolas', monospace;
    font-size: 12px;
    font-weight: bold;
}
QTabBar::tab:hover {
    color: #e5e5e5;
    background: rgba(255,255,255, 0.02);
}
QTabBar::tab:selected {
    color: #d97706;
    border-bottom: 2px solid #d97706;
}
QTabBar { background: transparent; }

/* ── List Widget (Activity Feed) ─────────────────────────────────────────── */
QListWidget {
    background: transparent;
    border: none;
    outline: none;
}
QListWidget::item {
    padding: 8px 4px;
    border-bottom: 1px solid rgba(34, 34, 34, 0.3);
    color: #808080;
    background: transparent;
}
QListWidget::item:hover {
    background: rgba(255,255,255, 0.02);
}
QListWidget::item:selected {
    background: transparent;
    color: #808080;
}

/* ── Dialogs ─────────────────────────────────────────────────────────────── */
QDialog {
    background-color: #0a0a0a;
    border: 1px solid #222222;
    border-radius: 4px;
}
QMenu {
    background-color: #0a0a0a;
    border: 1px solid #222222;
    border-radius: 4px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 16px;
    border-radius: 2px;
    color: #e5e5e5;
}
QMenu::item:selected {
    background-color: #111111;
    color: #d97706;
}
QToolTip {
    background-color: #0a0a0a;
    border: 1px solid #222222;
    border-radius: 3px;
    color: #808080;
    padding: 6px 10px;
    font-size: 11px;
    font-family: 'SF Mono', 'Menlo', 'Cascadia Mono', 'Consolas', monospace;
}

/* ── Typography Label classes ────────────────────────────────────────────── */
QLabel#HeadlineLg {
    font-family: 'SF Mono', 'Menlo', 'Cascadia Mono', 'Consolas', monospace;
    font-size: 28px;
    font-weight: bold;
    color: #e5e5e5;
    background: transparent;
}
QLabel#HeadlineMd {
    font-family: 'SF Mono', 'Menlo', 'Cascadia Mono', 'Consolas', monospace;
    font-size: 20px;
    font-weight: bold;
    color: #e5e5e5;
    background: transparent;
}
QLabel#DataLg {
    font-family: 'SF Mono', 'Menlo', 'Cascadia Mono', 'Consolas', monospace;
    font-size: 18px;
    font-weight: bold;
    background: transparent;
}
QLabel#DataMd {
    font-family: 'SF Mono', 'Menlo', 'Cascadia Mono', 'Consolas', monospace;
    font-size: 14px;
    background: transparent;
}
QLabel#DataSm {
    font-family: 'SF Mono', 'Menlo', 'Cascadia Mono', 'Consolas', monospace;
    font-size: 12px;
    color: #808080;
    background: transparent;
}
QLabel#LabelSm {
    font-family: 'SF Mono', 'Menlo', 'Cascadia Mono', 'Consolas', monospace;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 0.02em;
    background: transparent;
}

/* ── Status Indicators ───────────────────────────────────────────────────── */
QLabel#StatusSafe    { color: #16a34a; background: transparent; }
QLabel#StatusWarning { color: #d97706; background: transparent; }
QLabel#StatusCritical{ color: #dc2626; background: transparent; }
QLabel#StatusMuted   { color: #525252; background: transparent; }

/* ── Activity Feed container ─────────────────────────────────────────────── */
QFrame#ActivityFeed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #0a0a0a, stop:1 #080808);
    border: 1px solid #222222;
    border-radius: 4px;
}

/* ── Auth Page ───────────────────────────────────────────────────────────── */
QWidget#AuthPage {
    background-color: #080808;
}

/* ── Section header labels (table headers inside cards) ──────────────────── */
QLabel#SectionHeader {
    font-family: 'SF Mono', 'Menlo', 'Cascadia Mono', 'Consolas', monospace;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 0.08em;
    color: #808080;
    background: transparent;
    text-transform: uppercase;
}

/* ── Separator / Divider ─────────────────────────────────────────────────── */
QFrame[frameShape="4"], QFrame[frameShape="5"] { /* HLine, VLine */
    background-color: #222222;
    border: none;
    max-height: 1px;
}
