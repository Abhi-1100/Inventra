/* ==========================================================================
   INVENTRA — Material Design 3 Dark Theme
   Design Tokens from stitch_screens reference
   Accent: #afc6ff  |  Base BG: #101419  |  Cards: #161b22 -> #12161c
   Sidebar: #181c21 | Border: #232a33 | Outline-variant: #424754
   ========================================================================== */

/* ── Global base ─────────────────────────────────────────────────────────── */
QWidget {
    background-color: #101419;
    color: #e0e2ea;
    font-family: "Hanken Grotesk", "Segoe UI", "Inter", sans-serif;
    font-size: 13px;
    border: none;
    outline: none;
}

QMainWindow, QWidget#CentralWidget, QWidget#AppShell {
    background-color: #101419;
}

/* ── Monospace data elements ─────────────────────────────────────────────── */
QTableView, QHeaderView::section,
QLineEdit[mono="true"], QDoubleSpinBox, QSpinBox {
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 14px;
}

/* ── Sidebar ─────────────────────────────────────────────────────────────── */
QWidget#Sidebar {
    background-color: #181c21;
    border-right: 1px solid #424754;
}

/* ── Body area ───────────────────────────────────────────────────────────── */
QWidget#Body {
    background-color: #101419;
}

/* ── TopAppBar / StatusBar ───────────────────────────────────────────────── */
QWidget#TopAppBar {
    background-color: #101419;
    border-bottom: 1px solid #424754;
}

/* ── Page Stack ──────────────────────────────────────────────────────────── */
QStackedWidget#PageStack {
    background-color: #101419;
}

/* ── QTableView — dense data grid ───────────────────────────────────────── */
QTableView {
    background-color: #101419;
    alternate-background-color: #101419;
    gridline-color: transparent;
    border: 1px solid #232a33;
    border-radius: 8px;
    selection-background-color: #1c2025;
    selection-color: #e0e2ea;
    outline: none;
}

QTableView::item {
    border-bottom: 1px solid rgba(35, 42, 51, 0.5);
    padding: 10px 16px;
    color: #e0e2ea;
    background-color: transparent;
}

QTableView::item:selected {
    background-color: #1c2025;
    color: #e0e2ea;
}

QTableView::item:hover {
    background-color: #1c2025;
}

QHeaderView {
    background-color: #0a0e13;
    border: none;
}

QHeaderView::section {
    background-color: #0a0e13;
    color: #8c90a0;
    padding: 10px 16px;
    font-family: "Hanken Grotesk", "Segoe UI", sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    border: none;
    border-bottom: 1px solid #232a33;
}

QHeaderView::section:horizontal:hover {
    background-color: #161b22;
    color: #e0e2ea;
}

QHeaderView::down-arrow { image: none; width: 0; }
QHeaderView::up-arrow   { image: none; width: 0; }

/* ── Scrollbars ─────────────────────────────────────────────────────────── */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #424754;
    min-height: 20px;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover { background: #8c90a0; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none; background: none; height: 0;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; }

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 6px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #424754;
    min-width: 20px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal:hover { background: #8c90a0; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none; background: none; width: 0;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: none; }

/* ── Form Inputs ─────────────────────────────────────────────────────────── */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #0a0e13;
    border: 1px solid #232a33;
    border-radius: 6px;
    padding: 8px 12px;
    color: #e0e2ea;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 14px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #afc6ff;
    background-color: #0a0e13;
}

QLineEdit:disabled {
    color: #424754;
    background-color: #161b22;
    border-color: #232a33;
}

QDoubleSpinBox, QSpinBox {
    background-color: #0a0e13;
    border: 1px solid #232a33;
    border-radius: 6px;
    padding: 6px 10px;
    color: #e0e2ea;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
}

QDoubleSpinBox:focus, QSpinBox:focus {
    border: 1px solid #afc6ff;
}

QDoubleSpinBox::up-button, QSpinBox::up-button,
QDoubleSpinBox::down-button, QSpinBox::down-button {
    background-color: #1c2025;
    border: none;
    border-left: 1px solid #232a33;
    width: 18px;
    border-radius: 0;
}
QDoubleSpinBox::up-button:hover, QSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover, QSpinBox::down-button:hover {
    background-color: #262a30;
}
QDoubleSpinBox::up-arrow, QSpinBox::up-arrow {
    image: none;
    width: 8px; height: 8px;
}
QDoubleSpinBox::down-arrow, QSpinBox::down-arrow {
    image: none;
    width: 8px; height: 8px;
}

/* ── Combo Box ───────────────────────────────────────────────────────────── */
QComboBox {
    background-color: #1c2025;
    border: 1px solid #232a33;
    border-radius: 6px;
    padding: 6px 12px;
    color: #e0e2ea;
    min-width: 120px;
    font-family: "JetBrains Mono", monospace;
    font-size: 14px;
}
QComboBox:focus { border: 1px solid #afc6ff; }
QComboBox::drop-down {
    border: none;
    width: 24px;
    border-radius: 0 6px 6px 0;
}
QComboBox::down-arrow {
    image: none;
    width: 0;
}
QComboBox QAbstractItemView {
    background-color: #1c2025;
    border: 1px solid #232a33;
    border-radius: 6px;
    selection-background-color: #262a30;
    selection-color: #afc6ff;
    color: #e0e2ea;
    outline: none;
    padding: 4px;
}
QComboBox QAbstractItemView::item {
    padding: 6px 12px;
    border-radius: 4px;
}

/* ── Push Buttons (base) ────────────────────────────────────────────────── */
QPushButton {
    background-color: transparent;
    border: 1px solid #232a33;
    color: #e0e2ea;
    padding: 7px 16px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
    font-family: "Hanken Grotesk", sans-serif;
}
QPushButton:hover {
    background-color: #1c2025;
    border-color: #424754;
}
QPushButton:pressed {
    background-color: #262a30;
}
QPushButton:disabled {
    color: #424754;
    background-color: transparent;
    border-color: #232a33;
}

/* ── Primary CTA button ─────────────────────────────────────────────────── */
QPushButton#PrimaryBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #1f6feb, stop:1 #0050a7);
    border: none;
    border-top: 1px solid rgba(175, 198, 255, 0.3);
    color: #fffcff;
    font-weight: 600;
    border-radius: 6px;
}
QPushButton#PrimaryBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #388bfd, stop:1 #1f6feb);
}
QPushButton#PrimaryBtn:pressed {
    background: #0050a7;
}

/* ── Secondary Ghost button ──────────────────────────────────────────────── */
QPushButton#SecondaryBtn {
    background-color: transparent;
    border: 1px solid #232a33;
    color: #c2c6d6;
}
QPushButton#SecondaryBtn:hover {
    background-color: #1c2025;
    border-color: #424754;
    color: #e0e2ea;
}

/* ── Danger button ───────────────────────────────────────────────────────── */
QPushButton#DangerBtn {
    background-color: transparent;
    border: 1px solid rgba(255, 180, 171, 0.5);
    color: #ffb4ab;
    border-radius: 6px;
}
QPushButton#DangerBtn:hover {
    background-color: #ffb4ab;
    color: #690005;
    border-color: #ffb4ab;
}

/* ── Filter Chip buttons ─────────────────────────────────────────────────── */
QPushButton#FilterChip {
    background-color: #1c2025;
    border: 1px solid #232a33;
    color: #c2c6d6;
    border-radius: 16px;
    padding: 4px 14px;
    font-size: 12px;
    font-family: "Hanken Grotesk", sans-serif;
    font-weight: 600;
}
QPushButton#FilterChip:hover {
    background-color: #262a30;
    border-color: #424754;
    color: #e0e2ea;
}
QPushButton#FilterChip[active="true"] {
    background-color: rgba(175, 198, 255, 0.15);
    border: 1px solid rgba(175, 198, 255, 0.4);
    color: #afc6ff;
}

/* ── Auth PIN Keypad buttons ─────────────────────────────────────────────── */
QPushButton#PinBtn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #262a30, stop:1 #1c2025);
    border: 1px solid #424754;
    color: #e0e2ea;
    font-family: "JetBrains Mono", monospace;
    font-size: 20px;
    font-weight: 500;
    border-radius: 40px; /* Full circle */
    min-width: 76px;
    min-height: 76px;
    max-width: 76px;
    max-height: 76px;
}
QPushButton#PinBtn:hover {
    background-color: #31353b;
    border-color: #afc6ff;
}
QPushButton#PinBtn:pressed {
    background-color: rgba(31, 111, 235, 0.3);
    border-color: #afc6ff;
    border-top: 2px solid #afc6ff;
    color: #ffffff;
}

QPushButton#PinBackspaceBtn {
    background: transparent;
    border: none;
    color: #8c90a0;
    font-size: 20px;
    border-radius: 40px;
    min-width: 76px;
    min-height: 76px;
    max-width: 76px;
    max-height: 76px;
}
QPushButton#PinBackspaceBtn:hover {
    background-color: rgba(255, 180, 171, 0.08);
    color: #ffb4ab;
}

/* ── Card / Panel Frames ─────────────────────────────────────────────────── */
QFrame#MetricCard, QWidget#AuthCard,
QFrame#PanelFrame, QFrame#FormFrame,
QFrame#GlassCard {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #161b22, stop:1 #12161c);
    border: 1px solid #232a33;
    border-radius: 8px;
}

/* ── Tab Widget ──────────────────────────────────────────────────────────── */
QTabWidget::pane {
    background: #101419;
    border: 1px solid #232a33;
    border-radius: 0 0 8px 8px;
    border-top: none;
}
QTabBar::tab {
    background: transparent;
    color: #8c90a0;
    padding: 8px 20px;
    border: none;
    border-bottom: 2px solid transparent;
    font-family: "Hanken Grotesk", sans-serif;
    font-size: 13px;
    font-weight: 500;
}
QTabBar::tab:hover {
    color: #e0e2ea;
    background: rgba(255,255,255, 0.03);
}
QTabBar::tab:selected {
    color: #afc6ff;
    border-bottom: 2px solid #afc6ff;
    font-weight: 600;
}
QTabBar { background: transparent; }

/* ── List Widget (Activity Feed) ─────────────────────────────────────────── */
QListWidget {
    background: transparent;
    border: none;
    outline: none;
}
QListWidget::item {
    padding: 8px 4px;
    border-bottom: 1px solid rgba(66, 71, 84, 0.3);
    color: #c2c6d6;
    background: transparent;
}
QListWidget::item:hover {
    background: rgba(255,255,255, 0.03);
}
QListWidget::item:selected {
    background: transparent;
    color: #c2c6d6;
}

/* ── Dialogs ─────────────────────────────────────────────────────────────── */
QDialog {
    background-color: #1c2025;
    border: 1px solid #232a33;
    border-radius: 8px;
}
QMenu {
    background-color: #1c2025;
    border: 1px solid #232a33;
    border-radius: 8px;
    padding: 4px;
}
QMenu::item {
    padding: 6px 16px;
    border-radius: 4px;
    color: #e0e2ea;
}
QMenu::item:selected {
    background-color: #262a30;
    color: #afc6ff;
}
QToolTip {
    background-color: #1c2025;
    border: 1px solid #424754;
    border-radius: 6px;
    color: #c2c6d6;
    padding: 6px 10px;
    font-size: 12px;
    font-family: "JetBrains Mono", monospace;
}

/* ── Typography Label classes ────────────────────────────────────────────── */
QLabel#HeadlineLg {
    font-family: "Hanken Grotesk", sans-serif;
    font-size: 32px;
    font-weight: 700;
    color: #e0e2ea;
    background: transparent;
}
QLabel#HeadlineMd {
    font-family: "Hanken Grotesk", sans-serif;
    font-size: 24px;
    font-weight: 600;
    color: #e0e2ea;
    background: transparent;
}
QLabel#DataLg {
    font-family: "JetBrains Mono", monospace;
    font-size: 18px;
    font-weight: 500;
    background: transparent;
}
QLabel#DataMd {
    font-family: "JetBrains Mono", monospace;
    font-size: 14px;
    font-weight: 400;
    background: transparent;
}
QLabel#DataSm {
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    font-weight: 400;
    color: #8c90a0;
    background: transparent;
}
QLabel#LabelSm {
    font-family: "Hanken Grotesk", sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    background: transparent;
}

/* ── Status Indicators ───────────────────────────────────────────────────── */
QLabel#StatusSafe    { color: #afc6ff; background: transparent; }
QLabel#StatusWarning { color: #c0c7d3; background: transparent; }
QLabel#StatusCritical{ color: #ffb4ab; background: transparent; }
QLabel#StatusMuted   { color: #8c90a0; background: transparent; }

/* ── Activity Feed container ─────────────────────────────────────────────── */
QFrame#ActivityFeed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #161b22, stop:1 #12161c);
    border: 1px solid #232a33;
    border-radius: 8px;
}

/* ── Auth Page ───────────────────────────────────────────────────────────── */
QWidget#AuthPage {
    background-color: #101419;
}

/* ── Section header labels (table headers inside cards) ──────────────────── */
QLabel#SectionHeader {
    font-family: "Hanken Grotesk", sans-serif;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #8c90a0;
    background: transparent;
    text-transform: uppercase;
}

/* ── Separator / Divider ─────────────────────────────────────────────────── */
QFrame[frameShape="4"], QFrame[frameShape="5"] { /* HLine, VLine */
    background-color: #232a33;
    border: none;
    max-height: 1px;
}
