/* ==========================================================================
   KIRANA TERMINAL - Global Dark QSS Stylesheet
   Bloomberg Terminal / Fincept Terminal Dense Monospace Aesthetics
   ========================================================================== */

/* Global base styles */
QWidget {
    background-color: #0d1117;
    color: #e6edf3;
    font-family: "Segoe UI", "Inter", -apple-system, sans-serif;
    font-size: 12px;
}

/* Core monospaced fonts for numerical grids */
QTableView, QHeaderView, QLineEdit, QDoubleSpinBox, QSpinBox, QToolTip {
    font-family: "Consolas", "JetBrains Mono", "Courier New", monospace;
}

/* QMainWindow layout surface */
QMainWindow {
    background-color: #0d1117;
}

/* Central widget container */
QWidget#CentralWidget {
    background-color: #0d1117;
}

/* --------------------------------------------------------------------------
   QTableView - Density Grid Styling
   -------------------------------------------------------------------------- */
QTableView {
    background-color: #0d1117;
    alternate-background-color: #0f1318;
    gridline-color: #21262d;
    border: 1px solid #30363d;
    border-radius: 4px;
    selection-background-color: #1c2128;
    selection-color: #e6edf3;
    outline: none;
}

QTableView::item {
    border-bottom: 1px solid #21262d;
    padding: 6px 10px;
    color: #e6edf3;
}

QTableView::item:selected {
    background-color: #1c2128;
    border-left: 2px solid #58a6ff;
}

/* Header Columns */
QHeaderView::section {
    background-color: #161b22;
    color: #8b949e;
    padding: 8px 10px;
    font-weight: bold;
    border: none;
    border-bottom: 2px solid #30363d;
    border-right: 1px solid #21262d;
    font-size: 10px;
}

QHeaderView::section:horizontal:hover {
    background-color: #21262d;
    color: #e6edf3;
}

/* --------------------------------------------------------------------------
   Scrollbars - Thin, Bloomberg-style
   -------------------------------------------------------------------------- */
QScrollBar:vertical {
    border: none;
    background: #0d1117;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: #30363d;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #8b949e;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background: #0d1117;
    height: 8px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background: #30363d;
    min-width: 20px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background: #8b949e;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none;
    background: none;
    width: 0px;
}

/* --------------------------------------------------------------------------
   Inputs and Form Controls
   -------------------------------------------------------------------------- */
QLineEdit, QDoubleSpinBox, QSpinBox {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 4px;
    padding: 6px 10px;
    color: #e6edf3;
    selection-background-color: #58a6ff;
    selection-color: #0d1117;
}

QLineEdit:focus, QDoubleSpinBox:focus, QSpinBox:focus {
    border: 1px solid #58a6ff;
    background-color: #0d1117;
}

/* Spinbox micro-buttons */
QDoubleSpinBox::up-button, QSpinBox::up-button,
QDoubleSpinBox::down-button, QSpinBox::down-button {
    background-color: #21262d;
    border: none;
    border-left: 1px solid #30363d;
    width: 16px;
}

QDoubleSpinBox::up-button:hover, QSpinBox::up-button:hover {
    background-color: #30363d;
}

/* --------------------------------------------------------------------------
   Tooltips
   -------------------------------------------------------------------------- */
QToolTip {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 3px;
    color: #8b949e;
    padding: 4px 8px;
    font-size: 11px;
}
