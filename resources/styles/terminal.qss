/* ==========================================================================
   INVENTRA — Global Dark QSS Stylesheet
   Dense data-terminal aesthetic for data screens;
   warmer / more spacious for auth screens.
   Accent: #1f6feb  |  BG: #0b0f14  |  Surface: #161b22
   ========================================================================== */

/* ── Global base ─────────────────────────────────────────────────────────── */
QWidget {
    background-color: #0b0f14;
    color: #e6edf3;
    font-family: "Segoe UI", "Inter", -apple-system, sans-serif;
    font-size: 12px;
}

QMainWindow {
    background-color: #0b0f14;
}

QWidget#CentralWidget {
    background-color: #0b0f14;
}

/* ── Monospace font for data cells ─────────────────────────────────────────  */
QTableView, QHeaderView::section,
QLineEdit[mono="true"], QDoubleSpinBox, QSpinBox, QToolTip {
    font-family: "JetBrains Mono", "Consolas", "Courier New", monospace;
}

/* ── Sidebar ─────────────────────────────────────────────────────────────── */
QWidget#Sidebar {
    background: #0b0f14;
    border-right: 1px solid #21262d;
}

/* ── QTableView — dense data grid ───────────────────────────────────────── */
QTableView {
    background-color: #0b0f14;
    alternate-background-color: #0e1319;
    gridline-color: #1e242c;
    border: 1px solid #30363d;
    border-radius: 6px;
    selection-background-color: #162032;
    selection-color: #e6edf3;
    outline: none;
}

QTableView::item {
    border-bottom: 1px solid #1e242c;
    padding: 5px 10px;
    color: #e6edf3;
}

QTableView::item:selected {
    background-color: #162032;
    border-left: 2px solid #1f6feb;
}

QTableView::item:hover {
    background-color: #131920;
}

QHeaderView::section {
    background-color: #161b22;
    color: #6e7681;
    padding: 7px 10px;
    font-weight: 600;
    font-size: 10px;
    letter-spacing: 0.5px;
    border: none;
    border-bottom: 2px solid #30363d;
    border-right: 1px solid #21262d;
    text-transform: uppercase;
}

QHeaderView::section:horizontal:hover {
    background-color: #1c2128;
    color: #e6edf3;
}

QHeaderView::section:horizontal:pressed {
    background-color: #21262d;
    color: #1f6feb;
}

/* Sort indicators */
QHeaderView::down-arrow { image: none; }
QHeaderView::up-arrow   { image: none; }

/* ── Scrollbars — thin Bloomberg-style ──────────────────────────────────── */
QScrollBar:vertical {
    border: none;
    background: #0b0f14;
    width: 7px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #30363d;
    min-height: 20px;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover { background: #6e7681; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none; background: none; height: 0;
}

QScrollBar:horizontal {
    border: none;
    background: #0b0f14;
    height: 7px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #30363d;
    min-width: 20px;
    border-radius: 3px;
}
QScrollBar::handle:horizontal:hover { background: #6e7681; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    border: none; background: none; width: 0;
}

/* ── Form Inputs ─────────────────────────────────────────────────────────── */
QLineEdit, QDoubleSpinBox, QSpinBox, QTextEdit, QPlainTextEdit {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 5px;
    padding: 7px 10px;
    color: #e6edf3;
    selection-background-color: #1f6feb;
    selection-color: #ffffff;
}

QLineEdit:focus, QDoubleSpinBox:focus, QSpinBox:focus,
QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #1f6feb;
    background-color: #0f1520;
}

QLineEdit:disabled, QDoubleSpinBox:disabled, QSpinBox:disabled {
    color: #6e7681;
    background-color: #0e1218;
    border-color: #21262d;
}

QDoubleSpinBox::up-button, QSpinBox::up-button,
QDoubleSpinBox::down-button, QSpinBox::down-button {
    background-color: #21262d;
    border: none;
    border-left: 1px solid #30363d;
    width: 16px;
}
QDoubleSpinBox::up-button:hover, QSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover, QSpinBox::down-button:hover {
    background-color: #30363d;
}

/* ── Combo Box ───────────────────────────────────────────────────────────── */
QComboBox {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 5px;
    padding: 7px 10px;
    color: #e6edf3;
    min-width: 120px;
}
QComboBox:focus  { border: 1px solid #1f6feb; }
QComboBox::drop-down {
    border: none;
    width: 20px;
}
QComboBox QAbstractItemView {
    background-color: #161b22;
    border: 1px solid #30363d;
    selection-background-color: #1f3a6e;
    color: #e6edf3;
    outline: none;
}

/* ── Tab Widget (used in Stock In/Out) ──────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid #30363d;
    border-radius: 6px;
    background-color: #0b0f14;
    margin-top: -1px;
}
QTabBar::tab {
    background: #161b22;
    color: #8b949e;
    padding: 8px 20px;
    border: 1px solid #30363d;
    border-bottom: none;
    border-radius: 5px 5px 0 0;
    font-size: 11px;
    font-weight: 500;
}
QTabBar::tab:selected {
    background: #0b0f14;
    color: #e6edf3;
    border-bottom: 2px solid #1f6feb;
}
QTabBar::tab:hover:!selected {
    background: #1c2128;
    color: #e6edf3;
}

/* ── Push Buttons ────────────────────────────────────────────────────────── */
QPushButton {
    background-color: #21262d;
    border: 1px solid #30363d;
    color: #e6edf3;
    padding: 7px 16px;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #2d333b;
    border-color: #6e7681;
}
QPushButton:pressed {
    background-color: #1c2128;
}
QPushButton:disabled {
    color: #6e7681;
    background-color: #161b22;
    border-color: #21262d;
}

/* Primary action button (blue accent) */
QPushButton#PrimaryBtn {
    background-color: #1f6feb;
    border: 1px solid #1f6feb;
    color: #ffffff;
    font-weight: 600;
}
QPushButton#PrimaryBtn:hover {
    background-color: #388bfd;
    border-color: #388bfd;
}
QPushButton#PrimaryBtn:pressed {
    background-color: #1158c7;
}

/* Danger button */
QPushButton#DangerBtn {
    background-color: rgba(248,81,73,0.12);
    border: 1px solid rgba(248,81,73,0.40);
    color: #f85149;
}
QPushButton#DangerBtn:hover {
    background-color: rgba(248,81,73,0.22);
}

/* ── Auth Screen — PIN pad buttons ──────────────────────────────────────── */
QPushButton#PinBtn {
    background-color: #161b22;
    border: 1px solid #30363d;
    color: #e6edf3;
    font-family: "JetBrains Mono", "Consolas", monospace;
    font-size: 18px;
    font-weight: 600;
    border-radius: 10px;
    min-width: 72px;
    min-height: 72px;
}
QPushButton#PinBtn:hover {
    background-color: #1f2731;
    border-color: #1f6feb;
}
QPushButton#PinBtn:pressed {
    background-color: #1f3a6e;
    border-color: #1f6feb;
}

QPushButton#PinBackspaceBtn {
    background-color: #161b22;
    border: 1px solid #30363d;
    color: #8b949e;
    font-size: 18px;
    border-radius: 10px;
    min-width: 72px;
    min-height: 72px;
}
QPushButton#PinBackspaceBtn:hover {
    background-color: #1c2128;
    color: #f85149;
    border-color: rgba(248,81,73,0.40);
}

/* ── Auth Card ───────────────────────────────────────────────────────────── */
QWidget#AuthCard {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 12px;
}

QWidget#AuthPage {
    background-color: #0b0f14;
}

/* ── Filter chip row ─────────────────────────────────────────────────────── */
QPushButton#FilterChip {
    background-color: #161b22;
    border: 1px solid #30363d;
    color: #8b949e;
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 500;
    min-width: 0;
}
QPushButton#FilterChip:hover {
    border-color: #6e7681;
    color: #e6edf3;
}
QPushButton#FilterChip[active="true"] {
    background-color: rgba(31,111,235,0.15);
    border-color: #1f6feb;
    color: #1f6feb;
    font-weight: 600;
}

/* ── Activity Feed (right rail on Dashboard) ─────────────────────────────── */
QWidget#ActivityFeed {
    background-color: #0e1318;
    border: 1px solid #30363d;
    border-radius: 6px;
}

QLabel#ActivityFeedHeader {
    color: #6e7681;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.5px;
}

QFrame#ActivityItem {
    background-color: #161b22;
    border: none;
    border-bottom: 1px solid #21262d;
}

/* ── Metric Cards ────────────────────────────────────────────────────────── */
QFrame#MetricCard {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 8px;
}

/* ── Section / panel frame ───────────────────────────────────────────────── */
QFrame#PanelFrame, QFrame#FormFrame {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 6px;
}

/* ── Status Bar strip ────────────────────────────────────────────────────── */
QWidget#StatusBar {
    background-color: #161b22;
    border-bottom: 1px solid #30363d;
}

/* ── Tooltips ────────────────────────────────────────────────────────────── */
QToolTip {
    background-color: #1c2128;
    border: 1px solid #30363d;
    border-radius: 4px;
    color: #8b949e;
    padding: 4px 8px;
    font-size: 11px;
    font-family: "Segoe UI", "Inter", sans-serif;
}

/* ── List Widget (daily entry list) ─────────────────────────────────────── */
QListWidget {
    background-color: #0b0f14;
    border: 1px solid #30363d;
    border-radius: 5px;
    outline: none;
}
QListWidget::item {
    padding: 8px 12px;
    border-bottom: 1px solid #1e242c;
    color: #e6edf3;
}
QListWidget::item:selected {
    background-color: #162032;
    color: #e6edf3;
}
QListWidget::item:hover {
    background-color: #131920;
}

/* ── Date Edit ───────────────────────────────────────────────────────────── */
QDateEdit {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 5px;
    padding: 6px 10px;
    color: #e6edf3;
    font-family: "JetBrains Mono", "Consolas", monospace;
}
QDateEdit:focus { border: 1px solid #1f6feb; }
QDateEdit::drop-down {
    border: none;
    width: 20px;
}
QCalendarWidget {
    background-color: #161b22;
    color: #e6edf3;
}

/* ── Group Box ───────────────────────────────────────────────────────────── */
QGroupBox {
    border: 1px solid #30363d;
    border-radius: 6px;
    margin-top: 10px;
    color: #6e7681;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.5px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
}

/* ── Progress Bar ────────────────────────────────────────────────────────── */
QProgressBar {
    background-color: #21262d;
    border: none;
    border-radius: 3px;
    height: 4px;
    text-align: center;
}
QProgressBar::chunk {
    background-color: #1f6feb;
    border-radius: 3px;
}

/* ── Message Box ─────────────────────────────────────────────────────────── */
QMessageBox {
    background-color: #161b22;
}
QMessageBox QLabel {
    color: #e6edf3;
}

/* ── Dialog ──────────────────────────────────────────────────────────────── */
QDialog {
    background-color: #161b22;
    border: 1px solid #30363d;
    border-radius: 8px;
}
