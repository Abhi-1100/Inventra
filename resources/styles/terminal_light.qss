/* Nexus Inventory Core (Light) */
QWidget {
    font-family: 'Inter', sans-serif;
    color: #0b1c30;
}

QMainWindow, QStackedWidget#MainStack > QWidget {
    background-color: #f8f9ff;
}

/* Sidebar */
QWidget#Sidebar {
    background: #ffffff;
    border-right: 1px solid #e2e8f0;
}

/* Auth Card */
QFrame#AuthCard {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 4px;
}

/* Inputs */
QLineEdit {
    background: #ffffff;
    border: 1px solid #c6c6cd;
    border-radius: 4px;
    padding: 8px;
    color: #0b1c30;
}

QLineEdit:focus {
    border: 1px solid #0d9488;
    background: #eaf1ff;
}

/* Buttons */
QPushButton {
    background: transparent;
    border: 1px solid #c6c6cd;
    color: #0b1c30;
    border-radius: 4px;
    padding: 6px 16px;
}

QPushButton:hover {
    background: #e5eeff;
}

QPushButton#PrimaryBtn {
    background: #0f172a;
    border: none;
    color: #ffffff;
}

QPushButton#PrimaryBtn:hover {
    background: #3f465c;
}

/* Tables */
QTableWidget {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    gridline-color: #e2e8f0;
    color: #0b1c30;
}
QHeaderView::section {
    background: #f8f9ff;
    border-bottom: 1px solid #e2e8f0;
    padding: 6px;
    font-weight: bold;
    color: #45464d;
}

/* MetricCard */
QFrame#MetricCard {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 4px;
}
